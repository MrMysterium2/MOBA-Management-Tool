-- Dokumentation 
-- /var/lib/mysql
-- DATENBANK ERSTELLEN 

CREATE DATABASE moba_team_management;
USE moba_team_management;

--Tabelle spieler erstellen
CREATE TABLE spieler (
    id INT AUTO_INCREMENT PRIMARY KEY,
    spielername VARCHAR(20) NOT NULL,
    vorname VARCHAR(20) NOT NULL,
    nachname VARCHAR(20) NOT NULL,
    email VARCHAR(20) NOT NULL,
    position ENUM('Top', 'Mid', 'Jungle', 'ADC', 'Support') NOT NULL,
    elo INT DEFAULT 1000
);

-- Tabelle team erstellen
CREATE TABLE team (
    id INT AUTO_INCREMENT PRIMARY KEY,
    name VARCHAR(20) NOT NULL,
    team_elo INT DEFAULT 0
);

--  Tabelle team_members erstellen
CREATE TABLE team_members (
    team_id INT,
    spieler_id INT,
    FOREIGN KEY (team_id) REFERENCES team(id),
    FOREIGN KEY (spieler_id) REFERENCES spieler(id),
    PRIMARY KEY (team_id, spieler_id)
);

-- Tabelle matchmaking erstellen
CREATE TABLE matchmaking (
    id INT AUTO_INCREMENT PRIMARY KEY,
    spieler1_id INT,
    spieler2_id INT,
    winner_id INT,
    datum DATETIME DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (spieler1_id) REFERENCES spieler(id),
    FOREIGN KEY (spieler2_id) REFERENCES spieler(id),
    FOREIGN KEY (winner_id) REFERENCES spieler(id)
);

-- Tabelle team_matchmaking erstellen
CREATE TABLE team_matchmaking (
    id INT AUTO_INCREMENT PRIMARY KEY,
    team1_id INT,
    team2_id INT,
    winner_id INT,
    datum DATETIME DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (team1_id) REFERENCES team(id),
    FOREIGN KEY (team2_id) REFERENCES team(id),
    FOREIGN KEY (winner_id) REFERENCES team(id)
);

-- Verwalten 
