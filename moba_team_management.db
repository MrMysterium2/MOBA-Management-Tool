INSERT INTO matchmaking (spieler1_id, spieler2_id, winner_id)
VALUES (1, 2, 1);

-- Ein Match zwischen zwei Teams erfassen
INSERT INTO team_matchmaking (team1_id, team2_id, winner_id)
VALUES (1, 2, 1);
